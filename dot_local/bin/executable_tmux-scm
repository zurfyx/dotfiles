#!/bin/sh
# Repo state for the tmux status bar, for the repo containing $1 (a pane cwd).
# Supports both Sapling and git, and runs on Linux and macOS.
#
# The bar must never block, so this only ever prints a cached line and forks a
# detached refresher when the cache goes stale. `sl status` in a large monorepo can take ~1s,
# far too slow to run inline on a redraw. Detection of the repo root is a pure
# shell walk up the tree for the same reason: no subprocess on the hot path, so
# a wedged VCS can never hang the status bar.
#
# Usage: tmux-scm <pane_cwd> [client_width]
set -u

TTL=12
LOCK_TTL=60

cwd="${1:-$PWD}"
[ -d "$cwd" ] || exit 0

# branch names are the one unbounded part of this segment, so cap them; the cap
# is tighter on narrow clients, where the window list has nothing to spare
width=${2:-999}
[ "$width" -ge 130 ] 2>/dev/null && IDENT_MAX=20 || IDENT_MAX=12

trunc() {
	if [ ${#1} -gt "$IDENT_MAX" ]; then
		printf '%s…' "$(printf '%s' "$1" | cut -c "1-$((IDENT_MAX - 1))")"
	else
		printf '%s' "$1"
	fi
}

CACHE_DIR="${TMPDIR:-/tmp}/tmux-scm-$(id -u)"
mkdir -p "$CACHE_DIR" 2>/dev/null || exit 0

# macOS ships no timeout(1); degrade to running unguarded rather than not at all
GUARD=''
for g in timeout gtimeout; do
	command -v "$g" >/dev/null 2>&1 && GUARD=$g && break
done
guard() {
	secs=$1
	shift
	if [ -n "$GUARD" ]; then "$GUARD" "$secs" "$@"; else "$@"; fi
}

# GNU stat and BSD stat share no flags
mtime() {
	stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# ─── find the repo ───────────────────────────────────────────────────────────
# git wins when a repo carries both markers: Sapling's dotgit clones keep a .git
# and answer to `sl root`, but the branch name is the more useful thing to show.
root=''
backend=''
dir=$(cd "$cwd" 2>/dev/null && pwd -P) || exit 0
while [ -n "$dir" ]; do
	if [ -e "$dir/.git" ]; then
		root=$dir
		backend=git
		break
	fi
	if [ -d "$dir/.hg" ] || [ -d "$dir/.sl" ]; then
		root=$dir
		backend=sl
		break
	fi
	[ "$dir" = "/" ] && break
	dir=$(dirname "$dir")
done
[ -n "$root" ] || exit 0

# the width bucket is part of the key: the cached line has truncation baked in
key=$(printf '%s' "$root" | tr -c 'A-Za-z0-9' '_')_$IDENT_MAX
cache="$CACHE_DIR/$key"
lock="$cache.lock"

# ─── render ──────────────────────────────────────────────────────────────────
# colour16 rather than `black`: terminals brighten bold ANSI colours
BOLD='#[fg=colour16,bold]'
DIM='#[fg=colour235,nobold]'

dirty_segment() { # $1 = tracked count, $2 = untracked count
	if [ "$1" -gt 0 ] || [ "$2" -gt 0 ]; then
		[ "$1" -gt 0 ] && printf ' %s●%s' "$BOLD" "$1"
		[ "$2" -gt 0 ] && printf ' %s?%s' "$DIM" "$2"
	else
		printf ' %s✓' "$DIM"
	fi
}

refresh_sl() {
	info=$(guard 30 sl log -r . -T '{phabdiff}\t{node|short}\t{if(activebookmark,activebookmark,"")}' \
		--reason "tmux status bar repo state - sl help log" 2>/dev/null)
	st=$(guard 30 sl status --reason "tmux status bar dirty indicator - sl help status" 2>/dev/null)

	diff=$(printf '%s' "$info" | cut -f1)
	node=$(printf '%s' "$info" | cut -f2)
	book=$(printf '%s' "$info" | cut -f3)
	tracked=$(printf '%s\n' "$st" | grep -c '^[MARC!]')
	untracked=$(printf '%s\n' "$st" | grep -c '^?')

	printf '%s%s' "$BOLD" "$(basename "$PWD")"
	if [ -n "$diff" ]; then
		printf ' %s%s' "$DIM" "$diff"
	elif [ -n "$node" ]; then
		printf ' %s%s' "$DIM" "$node"
	fi
	[ -n "$book" ] && printf ' %s%s' "$DIM" "$(trunc "$book")"
	dirty_segment "$tracked" "$untracked"
}

refresh_git() {
	head=$(guard 30 git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
		head=$(guard 30 git rev-parse --short HEAD 2>/dev/null)
	st=$(guard 30 git status --porcelain 2>/dev/null)
	# "<behind>\t<ahead>" relative to the tracking branch, empty if untracked
	sync=$(guard 30 git rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)

	untracked=$(printf '%s\n' "$st" | grep -c '^??')
	tracked=$(printf '%s\n' "$st" | grep -vc '^??')
	# grep -vc counts the trailing empty line that printf adds when $st is empty
	[ -z "$st" ] && tracked=0

	printf '%s%s' "$BOLD" "$(basename "$PWD")"
	[ -n "$head" ] && printf ' %s%s' "$DIM" "$(trunc "$head")"
	if [ -n "$sync" ]; then
		behind=$(printf '%s' "$sync" | cut -f1)
		ahead=$(printf '%s' "$sync" | cut -f2)
		[ "${ahead:-0}" -gt 0 ] 2>/dev/null && printf ' %s↑%s' "$DIM" "$ahead"
		[ "${behind:-0}" -gt 0 ] 2>/dev/null && printf ' %s↓%s' "$DIM" "$behind"
	fi
	dirty_segment "$tracked" "$untracked"
}

refresh() { # $1 = repo root, $2 = cache path
	cd "$1" || return 0
	case $backend in
	git) line=$(refresh_git) ;;
	*) line=$(refresh_sl) ;;
	esac
	printf '%s#[default]' "$line" >"$2.tmp" 2>/dev/null && mv "$2.tmp" "$2"
}

# ─── cache ───────────────────────────────────────────────────────────────────
now=$(date +%s)
stale=1
[ -r "$cache" ] && [ $((now - $(mtime "$cache"))) -lt "$TTL" ] && stale=0

if [ -d "$lock" ] && [ $((now - $(mtime "$lock"))) -ge "$LOCK_TTL" ]; then
	rmdir "$lock" 2>/dev/null
fi

if [ "$stale" -eq 1 ] && mkdir "$lock" 2>/dev/null; then
	# fully detached: tmux waits on stdout, so the child must not inherit the pipe
	(
		refresh "$root" "$cache"
		rmdir "$lock" 2>/dev/null
	) >/dev/null 2>&1 &
fi

[ -r "$cache" ] && cat "$cache"
exit 0
