#!/usr/bin/env bash
# pre-commit — last line of defense before anything lands in a public repo.
# Two checks: nothing leaky in the staged diff, and the right identity on
# the commit. CI runs the same scans, but catching it here means no history
# rewrite later.
set -euo pipefail

# 1. Scan the staged changes with gitleaks (secrets + the custom vocabulary
#    rules in .gitleaks.toml).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — brew install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --config .gitleaks.toml

# 2. Sanity-check the identity on the commit. This is not about hiding the
#    address — it is already public in every commit on GitHub — but about
#    catching a surprise identity (a work account, an unconfigured machine)
#    before it lands in a public repo.
email="$(git config user.email || true)"
case "$email" in
  gerard.rovira.sanchez@gmail.com|*@users.noreply.github.com)
    ;;
  '')
    echo "pre-commit: no commit email configured." >&2
    echo "  git config user.email 'gerard.rovira.sanchez@gmail.com'" >&2
    exit 1
    ;;
  *)
    echo "pre-commit: unexpected commit email '$email' for a public repo." >&2
    echo "If that is deliberate, add it to the allowed list in .githooks/pre-commit." >&2
    exit 1
    ;;
esac
